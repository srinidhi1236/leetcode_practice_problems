class Solution:
    def rotateTheBox(self, boxGrid):
        m, n = len(boxGrid), len(boxGrid[0])

        for row in boxGrid:
            pos = n - 1
            for j in range(n - 1, -1, -1):
                if row[j] == '*':
                    pos = j - 1
                elif row[j] == '#':
                    row[j] = '.'
                    row[pos] = '#'
                    pos -= 1

        return [list(row) for row in zip(*boxGrid[::-1])]
