class Solution:
    def findItinerary(self, tickets):
        graph = {}

        for a, b in tickets:
            graph.setdefault(a, []).append(b)

        for a in graph:
            graph[a].sort(reverse=True)

        ans = []

        def dfs(city):
            while graph.get(city):
                dfs(graph[city].pop())
            ans.append(city)

        dfs("JFK")
        return ans[::-1]
