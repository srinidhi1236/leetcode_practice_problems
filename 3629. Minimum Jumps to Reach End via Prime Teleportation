from collections import deque

class Solution:
    def minJumps(self, nums):
        n = len(nums)
        limit = max(nums)

        prime = [True] * (limit + 1)
        prime[0] = prime[1] = False

        for i in range(2, int(limit ** 0.5) + 1):
            if prime[i]:
                for j in range(i * i, limit + 1, i):
                    prime[j] = False

        pos = {}
        for i, x in enumerate(nums):
            pos.setdefault(x, []).append(i)

        q = deque([(0, 0)])
        seen = {0}
        used = set()

        while q:
            i, steps = q.popleft()

            if i == n - 1:
                return steps

            for j in (i - 1, i + 1):
                if 0 <= j < n and j not in seen:
                    seen.add(j)
                    q.append((j, steps + 1))

            x = nums[i]
            if prime[x] and x not in used:
                used.add(x)

                for value in range(x, limit + 1, x):
                    for j in pos.get(value, []):
                        if j not in seen:
                            seen.add(j)
                            q.append((j, steps + 1))

        return -1
